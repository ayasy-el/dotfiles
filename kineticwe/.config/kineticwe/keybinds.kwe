# KineticWE keybinds — generated by Kinetic Settings. Only binds that
# differ from the defaults are stored. Copy this file into your dotfiles
# (or to another machine's ~/.config/kineticwe/) to share your binds; it
# is re-applied at every session start.
[kineticwe][Global Shortcuts]
Window Maximize=Meta+F
Move with Window to Desktop 1=Meta+!
Move with Window to Desktop 2=Meta+@
Move with Window to Desktop 3=Meta+#
Move with Window to Desktop 4=Meta+$
Move with Window to Desktop 5=Meta+%
Move with Window to Desktop 6=Meta+^
Move with Window to Desktop 7=Meta+&
Move with Window to Desktop 8=Meta+*
Move with Window to Desktop 9=Meta+(
Window Resize=Meta+R
Switch One Desktop Down=Meta+Down
Switch One Desktop to the Left=Meta+Left
Switch One Desktop to the Right=Meta+Right
Switch One Desktop Up=Meta+Up
Noctalia Launcher=Meta+A
Walk Through Windows=Meta+Tab
Walk Through Windows (Reverse)=Meta+Shift+Tab
Walk Through Windows of Current Application=Alt+Tab
Walk Through Windows of Current Application (Reverse)=Alt+Shift+Tab
Window One Desktop Down=Meta+Shift+Down
Window One Desktop to the Left=Meta+Shift+Left
Window One Desktop to the Right=Meta+Shift+Right
Window One Desktop Up=Meta+Shift+Up
[noctalia][Global Shortcuts]
NoctaliaToggleClipboard=Meta+V
[applications][Global Shortcuts]
org.kde.dolphin=Meta+E
[custom-commands][Global Shortcuts]
cmd-1=Meta+Return
cmd-2=Meta+ 
[org.kde.spectacle.desktop][Global Shortcuts]
RectangularRegionScreenShot=Meta+S
